const SHEET_NAME="Leads";const HEADERS=["timestamp","website","source","campaign","gclid","product","sku","size","sale_price","name","phone","house_number","street","ward","province","note","page_url","utm_source","utm_medium","utm_campaign"];
function doPost(e){try{const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);const p=e&&e.parameter?e.parameter:{};const clean=v=>String(v||"").replace(/^[=+\-@]/,"'").trim().slice(0,1000);const row=HEADERS.map(k=>k==="timestamp"?new Date():clean(p[k]));sh.appendRow(row);return HtmlService.createHtmlOutput('<meta charset="utf-8"><script>setTimeout(()=>location.href="https://thuvanreal-ai.github.io/mora-noi-that/cam-on/",800)</script><p>Đã nhận thông tin. MORA sẽ liên hệ xác nhận.</p>')}catch(err){return HtmlService.createHtmlOutput("Có lỗi khi nhận thông tin. Vui lòng gọi 0916 85 85 66.")}}
function doGet(){return ContentService.createTextOutput("MORA Lead Hub OK")}